<div data-accident-clusters data-initial-hidden="{{page.pins}}">
  {{#each accidentClusters}}<button
    type="button"
    class="cluster support-cluster"
    data-accident-cluster="{{index}}"
    style="left:{{left}}%;top:{{top}}%"
    data-initial-hidden="{{and @root.page.results (not last)}}"
    aria-label="{{label}} 사고 목록"
  >
    <span class="cluster__outer"
      ><span class="cluster__middle"
        ><span class="cluster__gradient"><b>{{choose @root.page.results '5' '4'}}</b></span></span
      ></span
    ><img src="{{@root.rootPath}}/images/support/cluster-pointer.svg" alt="" /><strong
      >{{label}}</strong
    ></button
  >{{/each}}
</div>
<div data-accident-pins data-initial-hidden="{{not page.pins}}">
  {{#each accidentPins}}<button
    type="button"
    class="accident-pin"
    data-accident-pin="{{index}}"
    style="left:{{left}}%;top:{{top}}%"
    aria-label="사고 {{index}} 상세 정보"
  >
    <img src="{{@root.rootPath}}/images/support/{{kind}}-pin.svg" alt="" />{{#if warning}}<img
      class="accident-pin__warning"
      src="{{@root.rootPath}}/images/support/warning.svg"
      alt="주의"
    />{{/if}}</button
  >{{/each}}
</div>
<section
  class="accident-detail"
  data-accident-detail
  role="dialog"
  aria-labelledby="accident-detail-title"
  tabindex="-1"
  data-initial-hidden="{{not page.detail}}"
>
  <div class="accident-detail__body">
    <header>
      <h2 id="accident-detail-title">
        <img src="{{rootPath}}/images/support/missing-dot.svg" alt="" />고성 연안 조타장치손상
      </h2>
      <button type="button" data-detail-close aria-label="상세 정보 닫기">
        <img src="{{rootPath}}/images/support/detail-close.svg" alt="" />
      </button>
    </header>
    <div class="accident-detail__content">
      <dl>
        <div>
          <dt>선박용도</dt>
          <dd>화물선<small>연안화물선</small></dd>
        </div>
        <div>
          <dt>선박톤수</dt>
          <dd>100~500톤</dd>
        </div>
      </dl>
      <dl>
        <div>
          <dt>사고위치</dt>
          <dd>고성군 연안</dd>
        </div>
        <div>
          <dt>발생일시</dt>
          <dd>2026-02-28 16:40</dd>
        </div>
        <div>
          <dt>사고유형</dt>
          <dd>조타장치손상</dd>
        </div>
      </dl>
      <footer>
        <span>인명피해</span>
        <div class="accident-detail__badges">
          <em class="support-badge support-badge--danger">사망 0</em>
          <em class="support-badge support-badge--neutral">실종 1</em>
          <em class="support-badge support-badge--warning">부상 0</em>
          <em class="support-badge support-badge--info">기타 0</em>
        </div>
      </footer>
    </div>
  </div>
  <img class="accident-detail__arrow" src="{{rootPath}}/images/support/detail-arrow.svg" alt="" />
</section>
<aside class="accident-legend" aria-label="인명피해 범례">
  <p>인명피해 기준 색상</p>
  {{#each damageLegend}}
  <div>
    <img src="{{@root.rootPath}}/images/support/{{kind}}-dot.svg" alt="" /><span>{{label}}</span>
  </div>
  {{/each}}
</aside>
